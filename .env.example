# Copie este archivo como .env para cambiar la configuración al compilar.
# Ninguna de estas variables es secreta, pero .env no se sube al repositorio.

# Dirección del servicio que recibe los formularios (cotización y contacto).
# Si se omite, se usa la de src/data/empresa.json → formularios.endpoint.
# FORM_ENDPOINT=https://formspree.io/f/XXXXXXXX

# Puerto del servidor local (opcional; por defecto 5050).
# PORT=5050
